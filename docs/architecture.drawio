Point x="1170" y="340"/><mxPoint x="1170" y="452"/></Array></mxGeometry></mxCell><mxCell id="e-34" value="容器 log / 指標" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecs_task-18" target="cloudwatch_2-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-35" value="超過閾值" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cloudwatch_2-24" target="sns-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#E7157B;fontColor=#E7157B;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sns-25" target="email_2-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note-37" value="&lt;b&gt;分層安全&lt;/b&gt;&lt;br&gt;網路：Public（ALB、NAT）→ App（ECS）→ Database（RDS）三層隔離&lt;br&gt;　　　Database 層 route table 沒有任何對外路由，資料無法直接送出 VPC&lt;br&gt;存取：ALB SG（80/443）→ ECS SG（8000，只收 ALB SG）→ RDS SG（5432，只收 ECS SG）&lt;br&gt;可用性：ALB 只檢查 /health/live（不查 DB），DB 切換時不會連帶重啟所有 task" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFF8E1;strokeColor=#F2A900;fontColor=#5A4A00;" vertex="1" parent="region-4"><mxGeometry x="65" y="750" width="540" height="140" as="geometry"/></mxCell><mxCell id="note-38" value="&lt;b&gt;半透明 = prod 差異&lt;/b&gt;（同一份 module，只換 terraform.tfvars）&lt;br&gt;• NAT Instance → 每 AZ 一台 NAT Gateway&lt;br&gt;• ECS 1–2 task → 2–4 task（跨 AZ）&lt;br&gt;• RDS Single-AZ → Multi-AZ + 刪除保護&lt;br&gt;• 備份 1 天 → 14 天" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFF8E1;strokeColor=#F2A900;fontColor=#5A4A00;" vertex="1" parent="region-4"><mxGeometry x="625" y="750" width="320" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cicd" name="2. CI/CD 與 IaC 流程"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt-1" value="&lt;b style='font-size:20px'&gt;CI/CD 與 IaC 生命週期 — GitHub Actions × OIDC × Terraform&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="box-2" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#F6F8FA;strokeColor=#24292F;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;container=1;collapsible=0;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="270" as="geometry"/></mxCell><mxCell id="txt-3" value="&lt;b style='font-size:14px'&gt;GitHub · yehchi/aws-infra-lab&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;align=left;" vertex="1" parent="box-2"><mxGeometry x="10" y="6" width="400" height="24" as="geometry"/></mxCell><mxCell id="users-4" value="開發者" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;fillColor=#232F3E;shape=mxgraph.aws4.users;fillColor=#5A6C86;" vertex="1" parent="box-2"><mxGeometry x="40" y="90" width="50" height="50" as="geometry"/></mxCell><mxCell id="box-5" value="&lt;b&gt;feature/xxx 分支&lt;/b&gt;&lt;br&gt;commit + push" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="box-2"><mxGeometry x="150" y="80" width="160" height="70" as="geometry"/></mxCell><mxCell id="box-6" value="&lt;b&gt;Pull Request&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;" vertex="1" parent="box-2"><mxGeometry x="360" y="80" width="140" height="70" as="geometry"/></mxCell><mxCell id="box-7" value="&lt;b&gt;pr-check.yml&lt;/b&gt;（自動）&lt;br&gt;• ruff lint&lt;br&gt;• docker build&lt;br&gt;• terraform plan（dev + prod 同時）&lt;br&gt;&lt;i&gt;（OIDC 臨時憑證，只預覽不變更）&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#E8F1FB;strokeColor=#1F6FEB;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="box-2"><mxGeometry x="550" y="45" width="240" height="135" as="geometry"/></mxCell><mxCell id="box-8" value="&lt;b&gt;Code Review&lt;/b&gt;&lt;br&gt;＋ Merge to main" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#DDF4E4;strokeColor=#1A7F37;fontColor=#232F3E;" vertex="1" parent="box-2"><mxGeometry x="840" y="80" width="160" height="70" as="geometry"/></mxCell><mxCell id="box-9" value="&lt;b&gt;deploy.yml&lt;/b&gt;&lt;br&gt;merge → dev 自動&lt;br&gt;手動 → prod" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#DDF4E4;strokeColor=#1A7F37;fontColor=#232F3E;" vertex="1" parent="box-2"><mxGeometry x="1040" y="80" width="170" height="70" as="geometry"/></mxCell><mxCell id="box-10" value="&lt;b&gt;destroy.yml&lt;/b&gt;&lt;br&gt;（手動：選環境 + 輸入 destroy）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#FFEBE9;strokeColor=#CF222E;fontColor=#232F3E;" vertex="1" parent="box-2"><mxGeometry x="1260" y="80" width="210" height="70" as="geometry"/></mxCell><mxCell id="note-11" value="&lt;b&gt;實測（2026-10-06）&lt;/b&gt;　Merge → 部署完成約 10.5 分鐘（infra 7 分 + app 3.4 分）&lt;br&gt;Destroy 約 6 分鐘 · log 中 account ID 出現 0 次（敏感值全放 GitHub Secrets）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFF8E1;strokeColor=#F2A900;fontColor=#5A4A00;" vertex="1" parent="box-2"><mxGeometry x="40" y="200" width="620" height="52" as="geometry"/></mxCell><mxCell id="e-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontColor=#24292F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users-4" target="box-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontColor=#24292F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-5" target="box-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;fontColor=#24292F;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-6" target="box-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-15" value="全綠才能合併" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A7F37;fontColor=#1A7F37;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0